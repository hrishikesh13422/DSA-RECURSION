#include<bits/stdc++.h>
using namespace std;

int largest_element(vector<int>&arr,int n){
    int largest=arr[0];
    for(int i=0;i<n;i++){
        if(arr[i]>largest){
            largest=arr[i];
        }
    }
    return largest;
}

int main(){
    vector<int> arr;
    int n;
    cin>>n;
    for(int i=0;i<n;i++){
        int temp;
        cin>>temp;
        arr.push_back(temp);
    }
    int largestel=largest_element(arr,n);
    cout<<largestel;
    return 0;

}
