#include<bits/stdc++.h>
using namespace std;
int second_smallest(vector<int>arr,int n){
    int smallest=arr[0];
    int second_small=INT_MAX;
    for(int i=0;i<n;i++){
        if(arr[i]<smallest){
            second_small=smallest;
            smallest=arr[i];
        }
        else if(arr[i]!=smallest && arr[i]<second_small){
            second_small=arr[i];
        }
    }
    return second_small;
    
}
int main(){
    vector<int>arr;
    int n;
    cin>>n;
    for(int i=0;i<n;i++){
        int temp;
        cin>>temp;
        arr.push_back(temp);
    }
    int small=second_smallest(arr,n);
    cout<<small;
    return 0;
}
